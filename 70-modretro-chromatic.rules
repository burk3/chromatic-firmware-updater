# ModRetro Chromatic USB access for ChromaticFirmwareUpdater.
#
# Upstream ships these as 99-modretro.rules with MODE="0666". Here access is
# granted to the active local session via the uaccess tag instead, which must
# be applied before 73-seat-late.rules, hence the 70- prefix.
SUBSYSTEM=="usb", ATTR{idVendor}=="33aa", ATTR{idProduct}=="0120", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="374e", ATTRS{idProduct}=="0101", TAG+="uaccess"
